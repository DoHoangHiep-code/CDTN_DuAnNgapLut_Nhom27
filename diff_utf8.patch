+// H├ám helper ─æß╗â giß║ú lß║¡p req, res v├á gß╗ìi route handler
+function mockAsk(message, domain = null) {
+    return new Promise((resolve) => {
+        const req = {
+            body: { message, domain }
+        }
+        const res = {
+            status: function(code) {
+                this.statusCode = code
+                return this
+            },
+            json: function(data) {
+                resolve({ statusCode: this.statusCode || 200, data })
+            }
+        }
+        
+        // T├¼m handler cß╗ºa POST /chatbot/ask
+        const layer = unifiedChatbotRouter.stack.find(l => l.route && l.route.path === '/chatbot/ask' && l.route.methods.post)
+        if (!layer) {
+            resolve({ error: 'Route /chatbot/ask not found' })
+            return
+        }
+        
+        // Gß╗ìi handler
+        const handler = layer.route.stack[0].handle
+        handler(req, res).catch(err => {
+            resolve({ error: err.message })
+        })
+    })
+}
+
+async function runTests() {
+    const testCases = [
+        { name: 'Top 10 ngß║¡p lß╗Ñt', query: 'H├úy liß╗çt k├¬ top 10 c├íc ─æiß╗âm c├│ khß║ú n─âng ngß║¡p lß╗Ñt cao nhß║Ñt', domain: 'flood' },
