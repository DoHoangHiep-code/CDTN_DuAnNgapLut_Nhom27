+        { name: 'Sß║ít lß╗ƒ 6 giß╗Ø tß╗øi', query: 'Xem nhß╗»ng v├╣ng c├│ khß║ú n─âng sß║ít lß╗ƒ trong 6 giß╗Ø tß╗øi', domain: 'landslide' },
+        { name: 'Ngß║¡p lß╗Ñt Triß╗üu Kh├║c 3 giß╗Ø tß╗øi', query: 'Triß╗üu Kh├║c ngß║¡p lß╗Ñt thß║┐ n├áo trong 3 giß╗Ø tß╗øi', domain: 'flood' },
+        { name: 'Sß║ít lß╗ƒ Sãín La trong 1,2,3,6h', query: 'Dß╗▒ b├ío sß║ít lß╗ƒ ß╗ƒ Sãín La trong 1,2,3,6 giß╗Ø tß╗øi', domain: 'landslide' }
+    ]
+
+    console.log('­ƒñû Bß║»t ─æß║ºu chß║íy test in-process cho Chatbot...\n')
+    for (const tc of testCases) {
+        console.log(`========================================`)
+        console.log(`­ƒº¬ Testcase: ${tc.name}`)
+        console.log(`­ƒÆ¼ C├óu hß╗Åi: "${tc.query}"`)
+        console.log(`========================================`)
+        
+        const result = await mockAsk(tc.query, tc.domain)
+        if (result.error) {
+            console.error(`ÔØî Lß╗ùi thß╗▒c thi:`, result.error)
+        } else {
+            console.log(`HTTP Status: ${result.statusCode}`)
+            console.log(`Intent nhß║¡n diß╗çn: ${result.data.intent}`)
+            console.log(`Khu vß╗▒c tr├¡ch xuß║Ñt: ${result.data.area || 'Kh├┤ng c├│'}`)
+            console.log(`Trß║ú lß╗Øi cß╗ºa Bot:\n`)
+            console.log(result.data.reply)
+            console.log(`Expert Nodes:`, JSON.stringify(result.data.expertNodes))
+        }
+        console.log('\n')
+    }
+    
+    process.exit(0)
+}
+
+runTests().catch(err => {
+    console.error('Lß╗ùi kiß╗âm thß╗¡:', err)
